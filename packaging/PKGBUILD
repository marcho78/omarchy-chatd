# Maintainer: marcho78
#
# Builds omarchy-chatd from the git checkout this file lives in. Install with:
#
#   git clone https://github.com/marcho78/omarchy-chatd && cd omarchy-chatd/packaging && makepkg -si
#
# Nothing is downloaded except crates, pinned by Cargo.lock. The binary you
# install is compiled from the committed source you can read one level up.

pkgname=omarchy-chatd
pkgver=0.1.0
pkgrel=1
pkgdesc="End-to-end encrypted Matrix daemon behind the Omarchy chat plugin"
arch=(x86_64 aarch64)
url="https://github.com/marcho78/omarchy-chatd"
license=(MIT)
depends=(gcc-libs glibc sqlite)
makedepends=(cargo git)
options=(!lto) # thin LTO is configured in Cargo.toml
# Clean checkout of the enclosing repository (committed HEAD, not the working tree).
source=("$pkgname::git+file://$startdir/..")
sha256sums=(SKIP)

prepare() {
  cd "$pkgname"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export CARGO_HOME="$srcdir/cargo-home"
  export RUSTUP_TOOLCHAIN=stable
  # Keep the builder's paths out of the binary (panic locations, debug info).
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/$pkgname"
  cargo build --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/omarchy-chatd "$pkgdir/usr/bin/omarchy-chatd"
  install -Dm644 omarchy-chatd.service "$pkgdir/usr/lib/systemd/user/omarchy-chatd.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
