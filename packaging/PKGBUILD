# Maintainer: marcho78
#
# Builds omarchy-yapperd as a pacman package from the git checkout this file
# lives in. The Yapper plugin does not need this: it builds the daemon into
# ~/.local/bin itself. For a system package, check out a release tag and:
#
#   cd packaging && makepkg -si
#
# Nothing is downloaded except crates, pinned by Cargo.lock. The binary you
# install is compiled from the committed source you can read one level up.

pkgname=omarchy-yapperd
pkgver=0.21.1
pkgrel=1
pkgdesc="End-to-end encrypted Matrix daemon behind the Yapper plugin"
arch=(x86_64 aarch64)
url="https://github.com/marcho78/omarchy-yapperd"
license=(MIT)
depends=(gcc-libs glibc sqlite)
# `rust`, not the virtual `cargo`: naming the provider spares makepkg the
# "rust or rustup?" question.
makedepends=(rust git)
# Earlier name of this package.
conflicts=(omarchy-chatd)
replaces=(omarchy-chatd)
options=(!lto) # thin LTO is configured in Cargo.toml
# Clean checkout of the enclosing repository (committed HEAD, not the working tree).
source=("$pkgname::git+file://$startdir/..")
sha256sums=(SKIP)

prepare() {
  cd "$pkgname"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export CARGO_HOME="$srcdir/cargo-home"
  export RUSTUP_TOOLCHAIN=stable
  # Keep the builder's paths out of the binary (panic locations, debug info).
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/$pkgname"
  cargo build --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/omarchy-yapperd "$pkgdir/usr/bin/omarchy-yapperd"
  install -Dm644 omarchy-yapperd.service "$pkgdir/usr/lib/systemd/user/omarchy-yapperd.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
